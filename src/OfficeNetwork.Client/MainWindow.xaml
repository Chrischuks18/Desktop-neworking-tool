<Window x:Class="OfficeNetwork.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Office Network Manager" Height="720" Width="1100"
        MinHeight="600" MinWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Office Network Manager" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="ConnectionStatus" Text="Not connected" Margin="0,6,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="Online Staff" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ListBox x:Name="OnlineUsers"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="ServerAddress" Width="280" Text="http://localhost:5077"/>
                    <TextBox x:Name="DisplayName" Width="180" Margin="8,0,0,0" Text="Director"/>
                    <ComboBox x:Name="RoleBox" Width="150" Margin="8,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Director"/>
                        <ComboBoxItem Content="Editor"/>
                        <ComboBoxItem Content="NewsSourcing"/>
                    </ComboBox>
                    <Button Content="Connect" Margin="8,0,0,0" Padding="18,5" Click="Connect_Click"/>
                </StackPanel>

                <ListBox x:Name="Messages" Grid.Row="1" Margin="0,0,0,10"/>

                <DockPanel Grid.Row="2">
                    <Button Content="Send Everyone" DockPanel.Dock="Right" Padding="15,7" Margin="8,0,0,0" Click="SendEveryone_Click"/>
                    <TextBox x:Name="MessageText" MinHeight="34" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,14,0,0"
                   Text="Files • Chat • Users • Permissions • Activity"/>
    </Grid>
</Window>
