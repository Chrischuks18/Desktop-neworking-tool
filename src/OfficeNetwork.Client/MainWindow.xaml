<Window x:Class="OfficeNetwork.Client.MainWindow" Icon="Assets/ChoiceFlameLogo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choice Flame Communications Network"
        Height="720" Width="1100" MinHeight="560" MinWidth="780"
        SizeToContent="Manual" ResizeMode="CanResizeWithGrip" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#123B6D"/>
        <SolidColorBrush x:Key="Red" Color="#B91C2B"/>
        <SolidColorBrush x:Key="Gold" Color="#D6A21E"/>
        <SolidColorBrush x:Key="Accent" Color="#B91C2B"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="OnlineGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="OfflineRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="StartingGold" Color="#D6A21E"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D8E0EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#D8E0EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#D8E0EA"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="7"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FBFCFE"/><Setter Property="BorderBrush" Value="#E5EAF0"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EAF0F6"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Red}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Navy}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="22,28,18,28">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Gold}" HorizontalAlignment="Left">
                        <Image Source="Assets/ChoiceFlameLogo.png" Width="58" Height="58" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Choice Flame" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock Text="COMMUNICATIONS NETWORK" Foreground="#B8C7D9" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Content="⌂   Dashboard" Tag="Dashboard" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="☑   Assigned Work" Tag="Assigned Work" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▦   Calendar of Activities" Tag="Calendar of Activities" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   Working Files" Tag="Working Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⇧   Submitted Files" Tag="Submitted Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✓   Final Files" Tag="Final Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✉   Office Chat" Tag="Office Chat" Click="Navigate_Click"/>
                    <Button x:Name="UsersNavButton" Style="{StaticResource NavButton}" Content="♟   Users" Tag="Users" Click="Navigate_Click"/>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate_Click"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="16,10,16,22" Padding="13" CornerRadius="10" Background="#0B2C52">
                    <StackPanel>
                        <TextBlock Text="SERVER STATUS" Foreground="#AFC3D7" FontSize="10" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="ServerStatusDot" Width="9" Height="9" Fill="{StaticResource OfflineRed}" Margin="0,4,8,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="White" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Good day, Director" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Manage your office files, staff and communication from one place."
                               Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="White" CornerRadius="22" Padding="15,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="{StaticResource Navy}"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock x:Name="CurrentUserName" Text="Not signed in" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="CurrentUserRole" Text="Connect or sign in" Foreground="{StaticResource Muted}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,24,0,10">
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="WORKING FILES" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DashboardWorkingCount" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Active workspace" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="SUBMITTED" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DashboardSubmittedCount" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Awaiting review" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="FINAL FILES" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DashboardFinalCount" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Approved work" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="ASSIGNED WORK" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DashboardAssignedCount" Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Pending assignments" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="ONLINE STAFF" Foreground="{StaticResource Muted}" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="●" FontSize="20" Foreground="{StaticResource OnlineGreen}"/><TextBlock x:Name="DashboardOnlineCount" Text="0" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="8,-4,0,0"/></StackPanel><TextBlock Text="Live network status" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" x:Name="DashboardContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.ColumnSpan="2" Grid.Row="0" Background="{StaticResource Navy}" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TODAY'S WORKFLOW" Foreground="#BFD1E5" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="DashboardWorkflowHeadline" Text="Your office workflow at a glance" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DashboardWorkflowDetail" Text="Sign in to load pending assignments and review activity." Foreground="#DCE7F2" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Assigned Work  →" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Tag="Assigned Work" Click="Navigate_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Office Chat" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                                <TextBlock Text="Send messages across the office network" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="MessageEveryoneButton" Content="Message Everyone" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="SendEveryone_Click"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,15,0,12">
                            <Grid>
                                <TextBlock x:Name="ChatConnectionInfo" Text="Connected using your signed-in Choice Flame account." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button Content="Reconnect" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Connect_Click"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="Messages" Grid.Row="2" BorderThickness="0" Background="#FBFCFE" Padding="8"/>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageText" MinHeight="40" Padding="10" VerticalContentAlignment="Center" KeyDown="MessageText_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Button x:Name="SendPrivateButton" Content="Send" Style="{StaticResource PrimaryButton}" Click="SendPrivate_Click"/><Button x:Name="SendEveryoneButton" Content="Send to Everyone" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SendEveryone_Click"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Online Staff" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBlock Text="Connected to the office network" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ListBox x:Name="OnlineUsers" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent"/>
                            <Button Grid.Row="1" x:Name="CallButton" Content="☎  Call Selected Staff" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="CallSelected_Click"/>
                            <Border Grid.Row="2" x:Name="CallPanel" Visibility="Collapsed" Background="#F0FDF4" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="CallStatus" Text="Call" Foreground="{StaticResource Navy}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="AcceptCallButton" Content="Accept" Style="{StaticResource PrimaryButton}" Click="AcceptCall_Click"/>
                                        <Button x:Name="DeclineCallButton" Content="Decline" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="DeclineCall_Click"/>
                                        <Button x:Name="MuteCallButton" Content="Mute" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="MuteCall_Click"/>
                                        <Button x:Name="EndCallButton" Content="End" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="EndCall_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="AssignmentsContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Assigned Work" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                        <TextBlock x:Name="AssignmentHelp" Text="Your pending and completed assignments." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                    </StackPanel>
                    <Border x:Name="AssignWorkPanel" Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Assign New Work" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="AssignmentStaff" Grid.Column="0" DisplayMemberPath="DisplayName" Padding="7" Margin="0,0,8,0" ToolTip="Select Editor or News Sourcing staff"/>
                                <TextBox x:Name="AssignmentTitle" Grid.Column="1" Padding="8" Margin="0,0,8,0" ToolTip="Work title"/>
                                <DatePicker x:Name="AssignmentDueDate" Grid.Column="2" Padding="5" ToolTip="Due date (optional)"/>
                            </Grid>
                            <TextBox x:Name="AssignmentInstructions" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" Margin="0,8,0,8" ToolTip="Instructions / note"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Attach File" Style="{StaticResource PrimaryButton}" Click="ChooseAssignmentFile_Click"/>
                                <TextBlock x:Name="AssignmentFileName" Text="No source file selected" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360"/>
                                <Button Content="Assign Work" Style="{StaticResource PrimaryButton}" Click="AssignWork_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="AssignmentList" Grid.Row="2" BorderThickness="0" SelectionMode="Single">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Work" DisplayMemberBinding="{Binding Title}" Width="210"/>
                            <GridViewColumn Header="Assigned To" DisplayMemberBinding="{Binding AssignedToDisplayName}" Width="150"/>
                            <GridViewColumn Header="Assigned By" DisplayMemberBinding="{Binding AssignedByDisplayName}" Width="140"/>
                            <GridViewColumn Header="Instructions" DisplayMemberBinding="{Binding Instructions}" Width="260"/>
                            <GridViewColumn Header="File" DisplayMemberBinding="{Binding FileName}" Width="150"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="90"/>
                            <GridViewColumn Header="Assigned" DisplayMemberBinding="{Binding AssignedAt}" Width="150"/>
                            <GridViewColumn Header="Due" DisplayMemberBinding="{Binding DueAt}" Width="140"/>
                            <GridViewColumn Header="Finished" DisplayMemberBinding="{Binding CompletedAt}" Width="150"/>
                        </GridView></ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open Attached File" Style="{StaticResource SecondaryButton}" Click="OpenAssignmentFile_Click"/>
                        <Button x:Name="CompleteAssignmentButton" Content="Submit Finished Work" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="CompleteAssignment_Click"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshAssignments_Click"/>
                        <TextBlock x:Name="AssignmentStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Navy}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="CalendarContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="OFFICE CALENDAR" Foreground="{StaticResource Red}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Calendar of Activities" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,3,0,12"/>
                        <Calendar x:Name="ActivityCalendar" SelectedDatesChanged="ActivityCalendar_SelectedDatesChanged"/>
                        <TextBlock x:Name="CalendarSelectedDateText" Text="Select a day to see its activities." FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,14,0,6"/>
                        <ListView x:Name="DayActivitiesList" MinHeight="150" SelectionChanged="DayActivitiesList_SelectionChanged">
                            <ListView.View><GridView><GridViewColumn Header="Activity" DisplayMemberBinding="{Binding Title}" Width="180"/><GridViewColumn Header="Details" DisplayMemberBinding="{Binding Details}" Width="150"/></GridView></ListView.View>
                        </ListView>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Activity Details" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBlock Text="Director and Admin can schedule office activities. Other staff can view the shared calendar." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            <TextBlock Text="Date" FontWeight="SemiBold"/><DatePicker x:Name="ActivityDatePicker" Margin="0,5,0,10"/>
                            <TextBlock Text="Activity / Event" FontWeight="SemiBold"/><TextBox x:Name="ActivityTitle" Margin="0,5,0,10"/>
                            <TextBlock Text="Details / Coverage Instructions" FontWeight="SemiBold"/><TextBox x:Name="ActivityDetails" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"/>
                            <StackPanel x:Name="CalendarManagePanel" Orientation="Horizontal">
                                <Button Content="Add Activity" Style="{StaticResource PrimaryButton}" Click="SaveActivity_Click"/>
                                <Button Content="Update Selected" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="UpdateActivity_Click"/>
                                <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteActivity_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CalendarStatus" Foreground="{StaticResource Navy}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <Border Background="#FFF8E1" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="Reminders: morning and evening one day before an activity, and again on the morning of the activity." TextWrapping="Wrap" Foreground="{StaticResource Navy}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SettingsContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Border Background="#EEF4FA" CornerRadius="10" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="SERVER ADMINISTRATION" Foreground="{StaticResource Red}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Server Setup" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,3,0,0"/></StackPanel></Border>
                    <TextBlock Text="Configure this computer as the Choice Flame office server." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                    <TextBlock Text="Office Files Storage Location" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="Choose a secondary drive or data disk for Working, Submitted, Final and Assigned Work files." Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerRootPath" Text="C:\Choice Flame Communications" Padding="10" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Choose Drive / Folder" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ChooseStorageLocation_Click"/>
                    </Grid>
                    <TextBlock x:Name="StorageDriveInfo" Text="Current storage information will appear here." Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Apply Storage Location" Style="{StaticResource PrimaryButton}" Click="ApplyStorageLocation_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Set Up This PC as Server" Style="{StaticResource PrimaryButton}" Click="SetupServer_Click"/>
                        <Button Content="Start Server" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="StartServer_Click"/>
                        <Button Content="Restart Office Server" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="RestartServer_Click"/>
                        <Button Content="Run Diagnostics" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Diagnostics_Click"/>
                    </StackPanel>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <TextBlock x:Name="SettingsStatus" Text="Server has not been configured from this screen yet." TextWrapping="Wrap" Foreground="{StaticResource Navy}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="UsersContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#EEF4FA" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="TEAM ACCESS" Foreground="{StaticResource Red}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Users &amp; Roles" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,3,0,0"/></StackPanel></Border>
                    <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Create New Account" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="NewDisplayName" Grid.Column="0" Margin="0,0,8,0" ToolTip="Full name"/>
                                <TextBox x:Name="NewUserName" Grid.Column="1" Margin="0,0,8,0" ToolTip="Username"/>
                                <PasswordBox x:Name="NewPassword" Grid.Column="2" Margin="0,0,8,0" ToolTip="Temporary password"/>
                                <ComboBox x:Name="NewRole" Grid.Column="3" Margin="0,0,8,0" SelectedIndex="2"><ComboBoxItem Content="Director"/><ComboBoxItem Content="Admin"/><ComboBoxItem Content="Editor"/><ComboBoxItem Content="NewsSourcing"/></ComboBox>
                                <Button Grid.Column="4" Content="Create User" Style="{StaticResource PrimaryButton}" Click="CreateUser_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" x:Name="UserStatus" Foreground="{StaticResource Navy}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ListView Grid.Row="3" x:Name="UserList" MinHeight="180" SelectionChanged="UserList_SelectionChanged">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding DisplayName}" Width="220"/>
                            <GridViewColumn Header="Username" DisplayMemberBinding="{Binding UserName}" Width="180"/>
                            <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role}" Width="130"/>
                            <GridViewColumn Header="Enabled" DisplayMemberBinding="{Binding IsEnabled}" Width="90"/>
                        </GridView></ListView.View>
                    </ListView>
                    <Border Grid.Row="4" x:Name="EditUserPanel" Visibility="Collapsed" Background="#FFF8E1" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Edit Selected Account" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="EditDisplayName" Grid.Column="0" Margin="0,0,8,0" ToolTip="Full name"/>
                                <TextBox x:Name="EditUserName" Grid.Column="1" Margin="0,0,8,0" ToolTip="Username"/>
                                <PasswordBox x:Name="EditPassword" Grid.Column="2" Margin="0,0,8,0" ToolTip="New password (leave blank to keep current password)"/>
                                <ComboBox x:Name="EditRole" Grid.Column="3" Margin="0,0,8,0"><ComboBoxItem Content="Director"/><ComboBoxItem Content="Admin"/><ComboBoxItem Content="Editor"/><ComboBoxItem Content="NewsSourcing"/></ComboBox>
                                <CheckBox x:Name="EditEnabled" Grid.Column="4" Content="Enabled" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Click="SaveUserChanges_Click"/>
                                <Button Content="Delete Account" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteUser_Click"/>
                                <TextBlock Text="Deleting an account does not delete its existing work files or assignment history." Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SectionContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="SectionHeading" Text="Files" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBlock x:Name="SectionHelp" Text="" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddWorkingFileButton" Content="Add File" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AddWorkingFile_Click"/>
                            <Button x:Name="OpenFileButton" Content="Open / Download" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFile_Click"/>
                            <Button x:Name="RefreshFilesButton" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshFiles_Click"/>
                            <Button x:Name="BackupFinalFilesButton" Content="Backup Final Files" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="BackupFinalFiles_Click" ToolTip="Copy all Final Files to a dated ZIP backup on a drive or folder you choose."/>
                            <Button x:Name="RenameFileButton" Content="Rename" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RenameFile_Click"/>
                            <Button x:Name="DeleteFileButton" Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteFile_Click"/>
                            <Button x:Name="RecallButton" Content="Recall Submission" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Recall_Click"/>
                            <Button x:Name="ReturnCorrectionButton" Content="Return for Correction" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ReturnCorrection_Click"/>
                            <Button x:Name="WorkflowButton" Content="Submit for Review" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Workflow_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="12" Margin="0,16,0,10">
                        <TextBlock x:Name="SectionNotice" Text="Files are managed on the Choice Flame office server." Foreground="{StaticResource Navy}"/>
                    </Border>
                    <Border Grid.Row="2" x:Name="DirectorMinutePanel" Visibility="Collapsed" Background="#FFF8E1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Director's Minute / Instruction" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBox x:Name="DirectorMinuteText" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="State what should be corrected before returning the file."/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="FileList" Grid.Row="3" BorderThickness="0" SelectionMode="Single" SelectionChanged="FileList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding Name}" Width="330"/>
                                <GridViewColumn Header="Owner" DisplayMemberBinding="{Binding OwnerUserName}" Width="140"/>
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="120"/>
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/>
                                <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding ModifiedAt}" Width="160"/>
                                <GridViewColumn Header="Director Minute" DisplayMemberBinding="{Binding DirectorMinute}" Width="260"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#EEF2F7" Panel.ZIndex="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Width="470" Padding="30" Background="White" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Choice Flame Communications Network" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="Connect to the office server and sign in with your individual account." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                    <TextBlock Text="Server address" FontWeight="SemiBold"/><TextBox x:Name="LoginServerAddress" Text="http://localhost:5077" Padding="10" Margin="0,5,0,12"/>
                    <TextBlock Text="Username" FontWeight="SemiBold"/><TextBox x:Name="LoginUserName" Padding="10" Margin="0,5,0,12"/>
                    <TextBlock Text="Password" FontWeight="SemiBold"/><PasswordBox x:Name="LoginPassword" Padding="10" Margin="0,5,0,16"/>
                    <Grid><Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource PrimaryButton}" Click="Login_Click"/><StackPanel x:Name="SignInProgress" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="70" Height="5" IsIndeterminate="True"/><TextBlock Text="  Signing in…" Foreground="White" FontWeight="SemiBold"/></StackPanel></Grid>
                    <TextBlock x:Name="LoginStatus" Foreground="{StaticResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="ServerAdministratorSetupButton" Content="Server Administrator Setup" Background="Transparent" Foreground="{StaticResource Navy}" BorderThickness="0" Margin="0,18,0,0" Click="ServerAdminMode_Click"/>
                    <Border x:Name="FirstDirectorPanel" Visibility="Collapsed" Background="#FFF8E1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Create the First Director" FontWeight="Bold" Foreground="{StaticResource Navy}" FontSize="16"/>
                            <TextBlock Text="This is required only once on a new server." Foreground="{StaticResource Muted}" Margin="0,3,0,10"/>
                            <TextBox x:Name="FirstDirectorName" Padding="8" Margin="0,0,0,8" ToolTip="Director full name"/>
                            <TextBox x:Name="FirstDirectorUserName" Padding="8" Margin="0,0,0,8" ToolTip="Director username"/>
                            <PasswordBox x:Name="FirstDirectorPassword" Padding="8" Margin="0,0,0,10" ToolTip="Director password"/>
                            <Button Content="Create Director Account" Style="{StaticResource PrimaryButton}" Click="CreateFirstDirector_Click"/>
                            <TextBlock x:Name="FirstDirectorStatus" Foreground="{StaticResource Red}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
