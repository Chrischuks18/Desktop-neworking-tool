<Window x:Class="OfficeNetwork.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choice Flame Communications Network"
        Height="780" Width="1240" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#123B6D"/>
        <SolidColorBrush x:Key="Red" Color="#B91C2B"/>
        <SolidColorBrush x:Key="Gold" Color="#D6A21E"/>
        <SolidColorBrush x:Key="Accent" Color="#B91C2B"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Navy}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="22,28,18,28">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Gold}" HorizontalAlignment="Left">
                        <TextBlock Text="CF" Foreground="White" FontWeight="Bold" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choice Flame" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock Text="COMMUNICATIONS NETWORK" Foreground="#B8C7D9" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Content="⌂   Dashboard" Tag="Dashboard" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   Working Files" Tag="Working Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⇧   Submitted Files" Tag="Submitted Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✓   Final Files" Tag="Final Files" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✉   Office Chat" Tag="Office Chat" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="♟   Users" Tag="Users" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate_Click"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="16,10,16,22" Padding="13" CornerRadius="10" Background="#0B2C52">
                    <StackPanel>
                        <TextBlock Text="SERVER STATUS" Foreground="#AFC3D7" FontSize="10" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Gold}" Margin="0,4,8,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="White" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Good day, Director" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Manage your office files, staff and communication from one place."
                               Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="White" CornerRadius="22" Padding="15,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="{StaticResource Navy}"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="Director" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Administrator" Foreground="{StaticResource Muted}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,10">
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="WORKING FILES" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Active workspace" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="SUBMITTED" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Awaiting review" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="FINAL FILES" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="—" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,7,0,0"/><TextBlock Text="Approved work" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="ONLINE STAFF" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="●" FontSize="27" Foreground="{StaticResource Red}" Margin="0,7,0,0"/><TextBlock Text="Live network status" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" x:Name="DashboardContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Office Chat" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                                <TextBlock Text="Send messages across the office network" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button Content="Message Everyone" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="SendEveryone_Click"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,15,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServerAddress" Grid.Column="0" Text="http://localhost:5077" Padding="8" ToolTip="Server address"/>
                                <TextBox x:Name="DisplayName" Grid.Column="1" Margin="8,0,0,0" Text="Director" Padding="8"/>
                                <ComboBox x:Name="RoleBox" Grid.Column="2" Margin="8,0,0,0" SelectedIndex="0" Padding="5">
                                    <ComboBoxItem Content="Director"/>
                                    <ComboBoxItem Content="Editor"/>
                                    <ComboBoxItem Content="NewsSourcing"/>
                                </ComboBox>
                                <Button Grid.Column="3" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Connect_Click"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="Messages" Grid.Row="2" BorderThickness="0" Background="#FBFCFE" Padding="8"/>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageText" MinHeight="40" Padding="10" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Send to Everyone" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="SendEveryone_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Online Staff" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBlock Text="Connected to the office network" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/>
                        </StackPanel>
                        <ListBox x:Name="OnlineUsers" Grid.Row="1" BorderThickness="0" Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="SettingsContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Server Setup" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="Configure this computer as the Choice Flame office server." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                    <TextBlock Text="Office files location" FontWeight="SemiBold"/>
                    <TextBox x:Name="ServerRootPath" Text="C:\Choice Flame Communications" Padding="10" Margin="0,6,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Set Up This PC as Server" Style="{StaticResource PrimaryButton}" Click="SetupServer_Click"/>
                        <Button Content="Start Server" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="StartServer_Click"/>
                        <Button Content="Run Diagnostics" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Diagnostics_Click"/>
                    </StackPanel>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <TextBlock x:Name="SettingsStatus" Text="Server has not been configured from this screen yet." TextWrapping="Wrap" Foreground="{StaticResource Navy}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="UsersContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Users &amp; Roles" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="User account management is being prepared. Server setup and file access are available from Settings." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="SectionContent" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="SectionHeading" Text="Files" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Navy}"/>
                            <TextBlock x:Name="SectionHelp" Text="" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RefreshFilesButton" Content="Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshFiles_Click"/>
                            <Button x:Name="WorkflowButton" Content="Submit for Review" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Workflow_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,2" Padding="12" Margin="0,16,0,10">
                        <TextBlock x:Name="SectionNotice" Text="Files are managed on the Choice Flame office server." Foreground="{StaticResource Navy}"/>
                    </Border>
                    <ListView x:Name="FileList" Grid.Row="2" BorderThickness="0" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding Name}" Width="380"/>
                                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="120"/>
                                <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding ModifiedAt}" Width="190"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
